# AgroRotate — Frontend Environment Configuration
# The client appends route names to this base, so it must include the /api/v1
# prefix the local API serves (e.g. ${API_BASE}/health → /api/v1/health).
# Leave it unset during offline/standalone development to use the local
# deterministic engine + localStorage fallback.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Server-only Earthdata credential (never prefix this with VITE_)
# ---------------------------------------------------------------------------
# Numeric NASA granules (HLS, SMAP, GPM, MODIS, ECOSTRESS) need Earthdata Login.
# The server checks these variables, or a ~/.netrc / _netrc entry for
# urs.earthdata.nasa.gov. Only the configured boolean and source label are sent
# to the browser; the credential itself is never exposed.
#
# EARTHDATA_TOKEN=
# EARTHDATA_BEARER_TOKEN=
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
#
# Without a credential the app still works: SoilGrids and SRTM terrain are live,
# and the four GIBS layers are available as visual context.
